{
    "name": "node-opcua-like-matcher",
    "version": "2.179.0",
    "description": "pure nodejs OPCUA SDK - the OPC 10000-4 Like FilterOperator (Table 120 wildcard matching)",
    "scripts": {
        "build": "tsc -b",
        "lint": "biome check --no-errors-on-unmatched .",
        "format": "biome check --write --no-errors-on-unmatched .",
        "clean": "npx rimraf -g node_modules dist *.tsbuildinfo",
        "test": "mocha",
        "test:check": "tsc --noEmit -p test/tsconfig.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "devEngines": {
        "node": ">=18.x",
        "npm": ">=10.x"
    },
    "dependencies": {},
    "author": "Etienne Rossignon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/node-opcua/node-opcua.git"
    },
    "keywords": [
        "OPCUA",
        "opcua",
        "m2m",
        "iot",
        "opc ua",
        "internet of things"
    ],
    "homepage": "http://node-opcua.github.io/",
    "files": [
        "dist",
        "source"
    ]
}
