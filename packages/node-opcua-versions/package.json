{
    "name": "node-opcua-versions",
    "version": "2.182.2",
    "//private": "kept private so that `lerna publish` skips it in the main pass; the publish workflow then runs `lerna publish from-package --include-private node-opcua-versions`, which publishes it after every other package of the release (see README, Where the matrix lives)",
    "private": true,
    "description": "pure nodejs OPCUA SDK - the release matrix of node-opcua: which version of every node-opcua-* package belongs to a release, and a CLI to bump, expand and check a package.json against it",
    "scripts": {
        "build": "tsc -b",
        "lint": "biome check --no-errors-on-unmatched .",
        "format": "biome check --write --no-errors-on-unmatched .",
        "clean": "npx rimraf -g node_modules dist *.tsbuildinfo",
        "test": "mocha",
        "test:check": "tsc --noEmit -p test/tsconfig.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "node-opcua-versions": "./dist/cli.js"
    },
    "devEngines": {
        "node": ">=18.x",
        "npm": ">=10.x"
    },
    "dependencies": {
        "commander": "^15.0.0"
    },
    "author": "Etienne Rossignon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/node-opcua/node-opcua.git"
    },
    "keywords": [
