{
    "name": "node-opcua-uanodeset-rdf",
    "type": "module",
    "version": "2.183.1",
    "description": "pure nodejs OPCUA SDK - a one-way JSON-LD (RDF) export of an OPC UA information model",
    "scripts": {
        "build": "tsc -b",
        "lint": "biome check --no-errors-on-unmatched .",
        "clean": "npx rimraf -g node_modules dist *.tsbuildinfo",
        "test": "mocha",
        "test:check": "tsc --noEmit -p test/tsconfig.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "engines": {
        "node": ">=22.13.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./session": {
            "types": "./dist/session.d.ts",
            "require": "./dist/session.js",
            "default": "./dist/session.js"
        },
        "./address-space": {
            "types": "./dist/address_space.d.ts",
            "require": "./dist/address_space.js",
            "default": "./dist/address_space.js"
        }
    },
    "devEngines": {
        "node": ">=18.x",
        "npm": ">=10.x"
    },
    "dependencies": {
        "node-opcua-address-space": "2.183.1",
        "node-opcua-data-model": "2.183.0",
        "node-opcua-json": "2.183.1",
        "node-opcua-nodeid": "2.183.0",
        "node-opcua-pseudo-session": "2.183.0",
        "node-opcua-service-browse": "2.183.0",
        "node-opcua-variant": "2.183.0"
    },
    "devDependencies": {
        "node-opcua-nodesets": "2.183.0"
    },
    "author": "Etienne Rossignon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/node-opcua/node-opcua.git"
    },
    "keywords": [
        "OPCUA",
        "opcua",
        "m2m",
        "iot",
        "opc ua",
        "internet of things",
        "rdf",
        "json-ld",
        "sparql"
    ],
    "homepage": "http://node-opcua.github.io/",
    "files": [
        "dist",
        "source",
        "VOCABULARY.md"
    ]
}
