{
    "extends": "../tsconfig.common.json",
    "compilerOptions": {
        "rootDir": "source",
        "outDir": "dist",
        "composite": true,
        "incremental": true
    },

    // no inputs of its own: this project exists to build the references below, so that the
    // generator and its dependencies are compiled before source/generate.ts runs. `files: []` is
    // the spelling for that; the previous `include: [""]` happened to match nothing under
    // TypeScript 5 and matches the whole package (tests included) under TypeScript 7.
    "files": [],
    "exclude": ["node_modules", "dist", "source"],
    "references": [
        {
            "path": "../node-opcua-data-model/tsconfig.json"
        },
        {
            "path": "../node-opcua-data-value/tsconfig.json"
        },
        {
            "path": "../node-opcua-generator/tsconfig.json"
        },
        {
            "path": "../node-opcua-numeric-range/tsconfig.json"
        },
        {
            "path": "../node-opcua-variant/tsconfig.json"
        }
    ]
}
