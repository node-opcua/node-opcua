{
    "name": "node-opcua-aggregates",
    "type": "module",
    "version": "2.184.6",
    "description": "pure nodejs OPCUA SDK - module aggregates",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -b",
        "test": "mocha test/*.ts",
        "test:check": "tsc --noEmit -p test/tsconfig.json",
        "lint": "biome check --no-errors-on-unmatched .",
        "format": "biome check --write --no-errors-on-unmatched .",
        "clean": "npx rimraf -g node_modules dist *.tsbuildinfo"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "node-opcua-address-space": "2.184.6",
        "node-opcua-assert": "2.184.0",
        "node-opcua-constants": "2.184.0",
        "node-opcua-data-model": "2.184.1",
        "node-opcua-data-value": "2.184.1",
        "node-opcua-nodeid": "2.184.1",
        "node-opcua-numeric-range": "2.184.1",
        "node-opcua-server": "2.184.6",
        "node-opcua-service-history": "2.184.1",
        "node-opcua-status-code": "2.184.1",
        "node-opcua-types": "2.184.1",
        "node-opcua-utils": "2.184.1",
        "node-opcua-variant": "2.184.1"
    },
    "devDependencies": {
        "node-opcua-leak-detector": "2.184.1",
        "node-opcua-nodesets": "2.184.0"
    },
    "author": "Etienne Rossignon",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/node-opcua/node-opcua.git"
    },
    "keywords": [
        "OPCUA",
        "opcua",
        "m2m",
        "iot",
        "opc ua",
        "internet of things"
    ],
    "homepage": "http://node-opcua.github.io/",
    "gitHead": "064029878247adf2fa5d14a8124e1930431e2428",
    "files": [
        "testHelpers.d.ts",
        "testHelpers.js",
        "distHelpers",
        "dist",
        "source"
    ]
}
